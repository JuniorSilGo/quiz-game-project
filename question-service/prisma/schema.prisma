generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id             String      @id @default(uuid())
  category       String
  difficulty     Difficulty
  questionText   String
  options        Json
  correctAnswer  String
  source         String?     
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("questions")
}