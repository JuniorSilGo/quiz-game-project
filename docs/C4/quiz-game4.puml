@startuml
title C4 - Código: MatchService

class MatchService {
  - repo: MatchRepository
  - scoreStrategy: IScoreStrategy
  - eventBus: EventPublisher
  + startMatch(roomId)
  + submitAnswer(playerId, answer)
  + nextRound()
}

class MatchRepository {
  + saveState()
  + loadState()
}

interface IScoreStrategy {
  + calculate(baseScore, time, difficulty)
}

class FastScoreStrategy {
  + calculate(...)
}

class NormalScoreStrategy {
  + calculate(...)
}

class EventPublisher {
  + emit(eventName, payload)
}

MatchService --> MatchRepository
MatchService --> IScoreStrategy
MatchService --> EventPublisher
FastScoreStrategy -up-|> IScoreStrategy
NormalScoreStrategy -up-|> IScoreStrategy

@enduml
