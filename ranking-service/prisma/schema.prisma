generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ranking {
  id        String   @default(cuid())
  userId    String   @unique      // identificador único do jogador
  username  String               // nome do jogador
  score     Int      @default(0) // pontuação atual
  level     Int      @default(1) // nível calculado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
