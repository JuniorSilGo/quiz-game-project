generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ranking {
  id           Int            @id @default(autoincrement())
  playerId     Int            @unique
  username     String
  score        Int            @default(0)
  level        Int            @default(1)
  position     Int?
  updatedAt    DateTime       @updatedAt
  matchHistory MatchHistory[]
}

model MatchHistory {
  id          Int      @id @default(autoincrement())
  playerId    Int
  result      String
  pointsDelta Int
  createdAt   DateTime @default(now())
  player      Ranking  @relation(fields: [playerId], references: [playerId])
}
