generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  PENDING
  RUNNING
  PAUSED
  FINISHED
  CANCELLED
}

model MatchEvent {
  id        Int      @id @default(autoincrement())
  matchId   Int
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  emittedBy Int?
  emittedAt DateTime @default(now())

  @@index([matchId])
  @@index([type])
}

model MatchSnapshot {
  id        Int       @id @default(autoincrement())
  matchId   Int
  match     Match     @relation(fields: [matchId], references: [id])
  state     Json
  createdAt DateTime  @default(now())
  ttlAt     DateTime?

  @@index([matchId])
  @@index([createdAt])
}

model Match {
  id           Int             @id @default(autoincrement())
  externalId   String?         @unique
  roomId       Int
  mode         String
  status       MatchStatus     @default(PENDING)
  currentRound Int             @default(0)
  totalRounds  Int             @default(10)
  startedAt    DateTime?
  endedAt      DateTime?
  timeLimitSec Int             @default(30)
  createdBy    Int?
  players      MatchPlayer[]
  rounds       Round[]
  events       MatchEvent[]
  snapshots    MatchSnapshot[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([roomId])
  @@index([status])
}

model MatchPlayer {
  id             Int            @id @default(autoincrement())
  matchId        Int
  match          Match          @relation(fields: [matchId], references: [id])
  playerId       Int
  username       String?
  avatar         String?
  score          Int            @default(0)
  totalXp        BigInt         @default(0)
  correctAnswers Int            @default(0)
  wrongAnswers   Int            @default(0)
  joinedAt       DateTime       @default(now())
  leftAt         DateTime?
  isActive       Boolean        @default(true)
  answers        PlayerAnswer[]

  @@unique([matchId, playerId])
  @@index([playerId])
}

model Round {
  id              Int       @id @default(autoincrement())
  matchId         Int
  match           Match     @relation(fields: [matchId], references: [id])
  index           Int
  questionId      Int?
  startedAt       DateTime?
  endedAt         DateTime?
  timeLimitSec    Int
  correctAnswerId Int?
  roundResult     Json?
  createdAt       DateTime  @default(now())

  answers PlayerAnswer[]

  @@unique([matchId, index])
  @@index([questionId])
}

model PlayerAnswer {
  id            Int         @id @default(autoincrement())
  roundId       Int
  round         Round       @relation(fields: [roundId], references: [id])
  matchPlayerId Int
  matchPlayer   MatchPlayer @relation(fields: [matchPlayerId], references: [id])
  playerId      Int
  answerId      Int
  isCorrect     Boolean?
  timeMs        Int?
  pointsAwarded Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([playerId])
  @@index([roundId])
}

model MatchHistory {
  id             Int       @id @default(autoincrement())
  matchId        Int       @unique
  roomId         Int
  winnerPlayerId Int?
  totalRounds    Int
  totalPlayers   Int
  startedAt      DateTime?
  endedAt        DateTime?
  summary        Json?
  createdAt      DateTime  @default(now())
}
