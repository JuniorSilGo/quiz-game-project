# ═══════════════════════════════════════════════════════════════════
# Auth Service - Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════════

# Banco de dados
DATABASE_URL="postgresql://quiz_user:quiz_password@localhost:5432/quiz_db?schema=auth"
# Para Docker: postgresql://quiz_user:quiz_password@postgres:5432/quiz_db?schema=auth

# Porta gRPC
GRPC_PORT=50051

# JWT (se aplicável)
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=1d
